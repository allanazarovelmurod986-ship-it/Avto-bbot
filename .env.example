# BotFather'dan olingan token
BOT_TOKEN=123456789:AAExampleTokenHere

# Google AI Studio'dan olingan Gemini API key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Ixtiyoriy: Gemini modeli (standart: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# AI javoblarni yoqish/o'chirish (false qilsangiz faqat avto javob/kalit so'z ishlaydi)
USE_AI=true

# Sizning shaxsiy Telegram ID'ingiz - boshqaruv menyusini faqat shu odam ko'radi.
# ID'ni bilish uchun Telegram'da @userinfobot ga /start yozing.
OWNER_ID=123456789

# Render'da Persistent Disk ulasangiz shu yerga mount pathni yozing (masalan /data/db.json).
# Ulamasangiz bo'sh qoldiring - lokal fayl ishlatiladi (Render restart/deploy'da tozalanishi mumkin).
DB_PATH=

# Faqat LOKAL test uchun kerak (masalan ngrok URL).
# Render'da bu shart emas - RENDER_EXTERNAL_URL avtomatik beriladi.
WEBHOOK_URL=

PORT=3000
